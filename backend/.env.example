# Export these variables before starting the backend; never commit actual secrets.
SESSION_SECRET=replace-with-at-least-32-random-characters
ACCESS_CODE=replace-with-a-long-private-access-code
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/nova.db
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
CHAT_MODEL=llama3.2:3b
REASONING_MODEL=deepseek-r1:8b
# For public hosting select compatible and configure your provider:
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
GLOBAL_REQUESTS_PER_MINUTE=60
