# Never commit actual secrets. Supabase publishable/anon key is intentionally public.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGINS=http://localhost:5173
LLM_PROVIDER=compatible
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
CHAT_MODEL=
# Optional; defaults to CHAT_MODEL when empty.
REASONING_MODEL=
GLOBAL_REQUESTS_PER_MINUTE=60
# Local Ollama is an explicit development option, not the cloud default:
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# CHAT_MODEL=llama3.2:3b
